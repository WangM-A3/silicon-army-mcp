{
  "@context": "https://modelcontextprotocol.io/schema/2025-03-26",
  "protocol_version": "2025-03-26",
  "name": "SiliconArmy Foreign Trade Agent",
  "version": "2.0.0",
  "description": "外贸硅基军团的 MCP Server — 确定性优先 + 真实API对接 + 并行工具调用 + 成本控制",
  "publisher": {
    "name": "SiliconArmy",
    "url": "https://siliconarmy.com"
  },
  "capabilities": {
    "resources": true,
    "tools": true,
    "prompts": false
  },
  "tools": [
    {
      "name": "discover_customers",
      "title": "客户发现",
      "description": "使用Google Custom Search发现潜在外贸客户",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {"type": "string", "description": "产品关键词，如 LED lighting"},
          "market": {"type": "string", "description": "目标市场，如 德国"},
          "product_info": {"type": "string", "description": "产品描述信息"},
          "limit": {"type": "integer", "description": "返回数量上限", "default": 10}
        },
        "required": ["keyword", "market"]
      }
    },
    {
      "name": "search_company_info",
      "title": "公司信息查询",
      "description": "通过Google搜索获取公司详细信息",
      "inputSchema": {
        "type": "object",
        "properties": {
          "company_name": {"type": "string", "description": "公司名称"}
        },
        "required": ["company_name"]
      }
    },
    {
      "name": "send_email",
      "title": "发送开发信",
      "description": "通过Resend API真实发送外贸开发邮件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to_address": {"type": "string", "description": "收件人邮箱"},
          "subject": {"type": "string", "description": "邮件主题"},
          "content": {"type": "string", "description": "邮件内容，支持HTML"},
          "template_type": {"type": "string", "enum": ["dev_letter", "follow_up", "product_intro"], "default": "dev_letter"}
        },
        "required": ["to_address", "subject", "content"]
      }
    },
    {
      "name": "batch_send_emails",
      "title": "批量发送邮件",
      "description": "通过Resend Batch API批量发送邮件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "recipients": {"type": "array", "description": "收件人列表", "items": {"type": "object", "properties": {"address": {"type": "string"}, "name": {"type": "string"}}}},
          "subject": {"type": "string"},
          "content": {"type": "string"},
          "template_type": {"type": "string", "enum": ["dev_letter", "follow_up", "product_intro"], "default": "dev_letter"}
        },
        "required": ["recipients", "subject", "content"]
      }
    },
    {
      "name": "get_email_tracking",
      "title": "邮件追踪",
      "description": "通过Resend API获取邮件发送状态和追踪数据",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email_id": {"type": "string", "description": "邮件ID"}
        },
        "required": ["email_id"]
      }
    },
    {
      "name": "send_whatsapp_message",
      "title": "发送WhatsApp消息",
      "description": "发送WhatsApp消息 (Demo模式)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phone_number": {"type": "string", "description": "电话号码，格式：+国家代码+号码"},
          "message": {"type": "string", "description": "消息内容"},
          "message_type": {"type": "string", "enum": ["text", "image", "document"], "default": "text"}
        },
        "required": ["phone_number", "message"]
      }
    },
    {
      "name": "send_whatsapp_product_card",
      "title": "发送产品卡片",
      "description": "发送WhatsApp产品信息卡片 (Demo模式)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phone_number": {"type": "string"},
          "product_name": {"type": "string"},
          "product_image": {"type": "string"},
          "price": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": ["phone_number", "product_name"]
      }
    },
    {
      "name": "get_whatsapp_message_status",
      "title": "WhatsApp消息状态",
      "description": "获取WhatsApp消息状态 (Demo模式)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {"type": "string"}
        },
        "required": ["message_id"]
      }
    },
    {
      "name": "query_import_data",
      "title": "进口海关数据",
      "description": "查询指定HS编码的进口数据 (Demo模式)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hs_code": {"type": "string", "description": "HS编码"},
          "country": {"type": "string", "description": "目的国"},
          "time_range": {"type": "string", "enum": ["last_month", "last_quarter", "last_year"], "default": "last_year"}
        },
        "required": ["hs_code", "country"]
      }
    },
    {
      "name": "query_export_data",
      "title": "出口海关数据",
      "description": "查询指定HS编码的出口数据 (Demo模式)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hs_code": {"type": "string"},
          "country": {"type": "string"},
          "time_range": {"type": "string", "enum": ["last_month", "last_quarter", "last_year"], "default": "last_year"}
        },
        "required": ["hs_code", "country"]
      }
    },
    {
      "name": "find_suppliers_by_product",
      "title": "供应商查找",
      "description": "从阿里巴巴搜索页面查找供应商",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_keyword": {"type": "string"},
          "country": {"type": "string", "default": "China"}
        },
        "required": ["product_keyword"]
      }
    },
    {
      "name": "validate_hs_code_tool",
      "title": "HS编码验证",
      "description": "确定性工具: 验证HS编码格式",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "description": "HS编码"}
        },
        "required": ["code"]
      }
    },
    {
      "name": "lookup_country_code",
      "title": "国家代码查询",
      "description": "确定性工具: 中英文/ISO代码互查",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "国家名或代码"}
        },
        "required": ["query"]
      }
    },
    {
      "name": "validate_email_tool",
      "title": "邮箱验证",
      "description": "确定性工具: 验证邮箱格式",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "description": "邮箱地址"}
        },
        "required": ["email"]
      }
    },
    {
      "name": "validate_phone_tool",
      "title": "电话验证",
      "description": "确定性工具: 验证国际电话号码格式",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phone": {"type": "string", "description": "电话号码"}
        },
        "required": ["phone"]
      }
    },
    {
      "name": "batch_execute",
      "title": "并行批量执行",
      "description": "并行执行多个独立工具调用，含成本控制(MAX_LOOPS/COST_BUDGET)和Replan-not-retry",
      "inputSchema": {
        "type": "object",
        "properties": {
          "calls": {
            "type": "array",
            "description": "调用列表，每项 {tool: string, arguments: object}",
            "items": {
              "type": "object",
              "properties": {
                "tool": {"type": "string"},
                "arguments": {"type": "object"}
              }
            }
          },
          "max_loops": {"type": "integer", "description": "覆盖默认最大调用数，0=使用环境变量", "default": 0},
          "cost_budget": {"type": "number", "description": "覆盖默认成本预算USD，0=使用环境变量", "default": 0}
        },
        "required": ["calls"]
      }
    }
  ],
  "resources": [
    {
      "uriPattern": "template:///{template_type}",
      "name": "Email Template",
      "description": "获取邮件模板",
      "mimeType": "text/plain"
    },
    {
      "uriPattern": "guide:///{guide_type}",
      "name": "User Guide",
      "description": "获取用户指南",
      "mimeType": "text/markdown"
    }
  ]
}
